# Domains. ACME_EMAIL is used only by the optional standalone Caddy deployment;
# Ploi manages Let's Encrypt itself.
ACME_EMAIL=admin@gfcodes.com
SITE_DOMAIN=gfcodes.com
API_DOMAIN=api.gfcodes.com

# Generate a long random value, for example: openssl rand -base64 48
REDIS_PASSWORD=replace_with_a_long_random_password

# Setlyvo Laravel service on the same VPS. This port stays loopback-only.
SETLYVO_API_UPSTREAM_URL=http://host.docker.internal:8080/api/v1/

# ENSELORA provider configuration — server only
ENSELORA_GEMINI_API_KEY=replace_me
ENSELORA_GEMINI_MODEL=gemini-3.7-flash
ENSELORA_REPLICATE_API_TOKEN=r8_replace_me
ENSELORA_REPLICATE_BACKGROUND_MODEL=851-labs/background-remover:a029dff38972b5fda4ec5d75d7d1cd25aeff621d2cf4946a41055d7db66b80bc
ENSELORA_ALLOWED_REMOTE_IMAGE_HOSTS=replicate.delivery
ENSELORA_REPLICATE_TRYON_MODEL_PRIMARY=prunaai/p-image-try-on
ENSELORA_REPLICATE_TRYON_MODEL_SECONDARY=
ENSELORA_TRYON_COMPARE_ENABLED=false
ENSELORA_REVENUECAT_SECRET_API_KEY=sk_replace_me
ENSELORA_REVENUECAT_WEBHOOK_AUTHORIZATION="Bearer replace_with_a_second_long_random_value"
ENSELORA_REVENUECAT_WEBHOOK_SIGNING_SECRET=replace_with_revenuecat_signing_secret
ENSELORA_TRYON_CREDIT_PRODUCTS_JSON='{"com.gabriel.enselora.tryon.credits10":10}'

# ENSELORA has its own Supabase project. The secret key is used only inside the
# private API container and must never be copied to the iOS app or public site.
ENSELORA_SUPABASE_URL=https://utwhmkaajdcodlkablyj.supabase.co
ENSELORA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Wn2FKDL2U8v_1XcFCiD5lw_MEpariQu
ENSELORA_SUPABASE_SECRET_KEY=sb_secret_replace_me

# Roll out App Attest as off -> observe -> enforce after a physical TestFlight test.
ENSELORA_APP_ATTEST_MODE=off
ENSELORA_APP_ATTEST_APP_ID=P657J6X62B.com.gabriel.enselora
ENSELORA_APP_ATTEST_ENVIRONMENT=production
ENSELORA_ADMIN_API_KEY=replace_with_a_third_long_random_value
# Leave blank unless your public admin IP is stable. Multiple exact IPv4/IPv6
# addresses can be separated by commas.
ENSELORA_ADMIN_ALLOWED_IPS=
ENSELORA_ADMIN_RATE_LIMIT_PER_MINUTE=20
ENSELORA_AUTH_RATE_LIMIT_PER_MINUTE=120

# Global/IP request ceilings and provider concurrency caps protect the shared
# provider accounts in addition to ENSELORA's per-user product quotas.
ENSELORA_GLOBAL_AI_RATE_LIMIT_PER_MINUTE=60
ENSELORA_IP_AI_RATE_LIMIT_PER_MINUTE=15
ENSELORA_GEMINI_MAX_CONCURRENCY=8
ENSELORA_REPLICATE_MAX_CONCURRENCY=3

# Gemini 3.7 Flash introductory USD pricing through 2026-12-31, expressed in
# millionths of USD per one million tokens. Review when provider pricing changes.
ENSELORA_GEMINI_INPUT_MICROS_PER_MILLION=750000
ENSELORA_GEMINI_OUTPUT_MICROS_PER_MILLION=3750000
# Conservative per-request reservations plus a hard daily server-side breaker.
# 1000000 micros = USD 1. Verify fixed Replicate estimates against its billing.
ENSELORA_GEMINI_REQUEST_RESERVE_COST_MICROS=25000
ENSELORA_REPLICATE_BACKGROUND_COST_MICROS=100000
ENSELORA_REPLICATE_TRYON_COST_MICROS=250000
ENSELORA_DAILY_COST_HARD_LIMIT_MICROS=10000000
ENSELORA_DAILY_COST_ALERT_MICROS=8000000
ENSELORA_COST_ALERT_WEBHOOK_URL=
